// phone.md HOME for the full metroid product.
//
// The release APK is built from the phone.md repo and supplied privately at
// this path. Keep the proved import shape until the native capture/input
// component is built and signed with this ROM's platform key.

android_app_import {
    name: "PhoneMdLauncher",
    apk: "PhoneMdLauncher.apk",
    presigned: true,
    preprocessed: true,
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: [
        // Qualcomm's tuna stack exposes no legacy effect UUIDs for Lineage
        // AudioFX. Its service then handles pending audio-session intents
        // after aborting initialization and crash-loops on a null manager.
        // phone.md owns the voice/audio UX and does not ship that equalizer.
        "AudioFX",
        "Launcher3",
        "Launcher3QuickStep",
        "LineageSetupWizard",
        "Provision",
    ],
}
